# Copy to web/.env. Vite only exposes variables that start with VITE_.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: map tiles for the location picker. Default is OpenStreetMap (fine for a prototype; its
# tile policy forbids heavy use, so use your own tile server or a provider in production).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
