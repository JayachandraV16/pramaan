# Copy to api/.env and fill in. NEVER commit api/.env.

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Browser origin(s) allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy (so req.ip is the real client)
# TRUST_PROXY=false

# --- Database (use DATABASE_URL, or the DB_* variables) ---------------------
# If the password contains # or @, wrap it in double quotes (DB_PASSWORD="p#ss") and prefer DB_*:
# an unquoted # starts a comment, which silently empties the value (symptom: ENOTFOUND postgres).
# DATABASE_URL=postgres://user:password@localhost:5432/pramaan
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=pramaan

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-value
# Signs QR payloads and file links. Required (>= 32 chars) when NODE_ENV=production.
INTEGRITY_SECRET=change-me-to-a-different-long-random-value
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# --- Files ------------------------------------------------------------------
# Defaults to api/uploads. Must be persistent storage in production.
# UPLOAD_DIR=
# Lifetime of signed file links, seconds
# FILE_URL_TTL_SECONDS=1800

# --- Misc -------------------------------------------------------------------
# LOG_LEVEL=info

# --- Optional: e-mail / SMS notifications -----------------------------------
# DELIVERY_MODE=off            # off | log (log only, for development) | live
# SMTP_URL=smtps://user:password@smtp.example.org:465
# EMAIL_FROM="Pramaan <no-reply@your-domain>"
# SMS_GATEWAY_URL=https://sms-gateway.example.org/send
# SMS_GATEWAY_TOKEN=
# SMS_SENDER_ID=PRAMAN

# --- Optional: S3-compatible file storage ------------------------------------
# STORAGE_DRIVER=local         # local | s3
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=                # MinIO / Cloudflare R2 etc.; empty for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=

# --- Optional: digitally signed certificate PDFs -----------------------------
# Create a development key with: npm run signing:dev-cert
# SIGNING_P12_PATH=
# SIGNING_P12_PASSPHRASE=

# --- Renewal window (days before expiry that re-verification opens) ----------
# RENEWAL_WINDOW_DAYS=60

# --- Optional: OCR nameplate check (run "npm run ocr:setup" once) ---------------
# OCR_ENABLED=true
# OCR_LANG_PATH=            # default: api/ocr-data
# OCR_TIMEOUT_MS=60000
